DISCORD_TOKEN=replace_with_bot_token
DISCORD_APPLICATION_ID=replace_with_application_id
DISCORD_GUILD_ID=replace_with_guild_id
METRICS_PORT=11940
# Optional: website origin behind every "visit the site" button (https origin, no path).
# Falls back to COMMUNITY_SITE_URL when that is set, otherwise to https://sukisuki.ai.
# SITE_URL=https://sukisuki.ai

# Set the five base CASE_* values together to enable reports. Keep keys outside Git.
# CASE_FORUM_ID=private_forum_id
# CASE_STAFF_ROLE_IDS=approved_role_id,another_approved_role_id
# CASE_DATABASE_PATH=/var/lib/hearthkeeper/cases.db
# CASE_IDENTITY_KEY=generate_32_random_bytes_as_hex
# CASE_LOOKUP_KEY=generate_a_different_32_random_bytes_as_hex

# Optional: dedicated normal text parent for NEW identified private conversations.
# CASE_PRIVATE_PARENT_ID=dedicated_text_channel_id
# CASE_PRIVATE_MAX_ACTIVE=100

# Optional HearthRoom integration. Disabled unless explicitly enabled.
# Keep the bridge key distinct from the Discord token and both CASE_* keys.
# COMMUNITY_ENABLED=true
# COMMUNITY_SITE_URL=https://sukisuki.ai
# COMMUNITY_BRIDGE_KEY=generate_an_independent_32_random_bytes_as_hex
# COMMUNITY_DATABASE_PATH=/var/lib/hearthkeeper/community.db
# COMMUNITY_XP_CHANNELS=explicit_public_text_channel_id
# COMMUNITY_ROLES=[]
# COMMUNITY_REVIEW_CHANNEL=private_staff_text_channel_id
# COMMUNITY_REVIEW_V2=true
# COMMUNITY_REVIEW_LOCALE=zh-Hant
# Optional daily update digest: one public announcement channel per language (zh-Hant, zh-Hans, en, ja, ko).
# COMMUNITY_UPDATES_CHANNELS=zh-Hans:notice_board_channel_id,zh-Hans:lobby_channel_id,en:another_public_channel_id
