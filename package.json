{
  "name": "hearthkeeper",
  "version": "0.2.0",
  "private": true,
  "description": "HearthRoom Discord community bot",
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "check": "npm test && npm run typecheck && npm run build",
    "start": "node dist/src/main.js",
    "register": "node dist/src/register.js"
  },
  "dependencies": {
    "@prometheus-io/client": "0.16.1",
    "discord.js": "14.27.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
